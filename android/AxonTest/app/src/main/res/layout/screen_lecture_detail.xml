<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="28dp">
    <TextView android:id="@+id/lecture_detail_subject" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/accent_amber" android:textSize="12sp" android:letterSpacing="0.08" />
    <TextView android:id="@+id/lecture_detail_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/text_primary" android:textSize="22sp" />
    <TextView android:id="@+id/lecture_detail_meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/text_muted" android:textSize="12sp" />
    <TextView android:id="@+id/lecture_detail_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:textColor="@color/text_primary" android:textSize="15sp" />
    <Button android:id="@+id/lecture_detail_back" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Back to Space" />
  </LinearLayout>
</ScrollView>