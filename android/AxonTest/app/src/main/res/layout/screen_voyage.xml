<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#0B0507">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical"><Button android:id="@+id/voyage_back" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_session_card" android:text="‹" android:textColor="#FFFFFF" android:textSize="30sp"/><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:text="FOCUS" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"/><Button android:id="@+id/bounty_tab" android:layout_width="84dp" android:layout_height="42dp" android:background="@drawable/bg_session_card" android:text="BOUNTY" android:textColor="#E5484D" android:textSize="10sp"/></LinearLayout>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="44dp" android:text="Make time\nfor what matters." android:textColor="#FFFFFF" android:textSize="34sp" android:textStyle="bold"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Choose a focus session. Finish it to earn Berries." android:textColor="#AEB2BD" android:textSize="15sp"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:background="@drawable/bg_session_card" android:gravity="center_vertical" android:padding="18dp"><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="YOUR BOUNTY" android:textColor="#A3927E" android:textSize="10sp"/><TextView android:id="@+id/voyage_bounty" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="#FFFFFF" android:textSize="25sp" android:textStyle="bold"/></LinearLayout><TextView android:id="@+id/voyage_timer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="READY" android:textColor="#E5484D" android:textSize="12sp" android:textStyle="bold"/></LinearLayout>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="34dp" android:text="SESSION LENGTH" android:textColor="#8E94A3" android:textSize="11sp"/>
  <RadioGroup android:id="@+id/voyage_tiers" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical"><RadioButton android:id="@+id/voyage_coastal" android:layout_width="match_parent" android:layout_height="76dp" android:background="@drawable/bg_session_selected" android:button="@null" android:gravity="center_vertical" android:paddingHorizontal="18dp" android:text="QUICK FOCUS     25 MIN     +600" android:textColor="#FFFFFF" android:textSize="14sp"/><RadioButton android:id="@+id/voyage_open" android:layout_width="match_parent" android:layout_height="76dp" android:layout_marginTop="10dp" android:background="@drawable/bg_session_card" android:button="@null" android:gravity="center_vertical" android:paddingHorizontal="18dp" android:text="DEEP WORK       50 MIN     +1.5K" android:textColor="#FFFFFF" android:textSize="14sp"/><RadioButton android:id="@+id/voyage_uncharted" android:layout_width="match_parent" android:layout_height="76dp" android:layout_marginTop="10dp" android:background="@drawable/bg_session_card" android:button="@null" android:gravity="center_vertical" android:paddingHorizontal="18dp" android:text="LONG SESSION    90 MIN     +3K" android:textColor="#FFFFFF" android:textSize="14sp"/></RadioGroup>
  <LinearLayout android:id="@+id/custom_voyage" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_session_card" android:orientation="vertical" android:padding="16dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CUSTOM LENGTH" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold"/><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center_vertical"><EditText android:id="@+id/custom_hours" android:layout_width="84dp" android:layout_height="44dp" android:background="@drawable/bg_focus_outline" android:hint="2.0" android:inputType="numberDecimal" android:paddingHorizontal="12dp" android:textColor="#FFFFFF" android:textColorHint="#808692"/><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:text="hours (minimum 1.5)" android:textColor="#A3927E" android:textSize="12sp"/><Button android:id="@+id/custom_set" android:layout_width="60dp" android:layout_height="42dp" android:background="@drawable/bg_focus_outline" android:text="SET" android:textColor="#E5484D" android:textSize="10sp"/></LinearLayout><TextView android:id="@+id/custom_preview" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="#E5484D" android:textSize="12sp"/></LinearLayout>
  <Button android:id="@+id/set_sail" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="26dp" android:background="@drawable/bg_session_button" android:text="START FOCUS SESSION" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"/>
  <Button android:id="@+id/abandon_ship" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="12dp" android:background="@drawable/bg_focus_outline" android:text="END SESSION" android:textColor="#FFB4AB" android:visibility="gone"/>
  <TextView android:id="@+id/voyage_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center" android:textColor="#AEB2BD" android:textSize="12sp"/>
 </LinearLayout>
</ScrollView>
