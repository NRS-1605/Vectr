<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="28dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:letterSpacing="0.12" android:text="TODO" android:textColor="@color/accent_amber" android:textSize="20sp" />
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:scrollbars="none"><LinearLayout android:id="@+id/todo_lists" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" /></HorizontalScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal"><EditText android:id="@+id/todo_input" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/bg_input" android:hint="Add a task…" android:paddingHorizontal="14dp" android:textColor="@color/text_primary" android:textColorHint="@color/text_muted" /><Button android:id="@+id/todo_add" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginStart="10dp" android:text="ADD" /></LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal"><Button android:id="@+id/todo_new_list" android:layout_width="wrap_content" android:layout_height="42dp" android:text="NEW LIST" /><Button android:id="@+id/todo_clear" android:layout_width="wrap_content" android:layout_height="42dp" android:layout_marginStart="10dp" android:text="CLEAR ALL" /></LinearLayout>
    <TextView android:id="@+id/todo_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/text_muted" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"><LinearLayout android:id="@+id/todo_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" /></ScrollView>
</LinearLayout>