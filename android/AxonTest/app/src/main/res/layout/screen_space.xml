<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="28dp">
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:letterSpacing="0.12" android:text="SPACE" android:textColor="@color/accent_amber" android:textSize="20sp" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
    <TextView android:id="@+id/space_notes_tab" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:gravity="center" android:text="Notes" android:textColor="@color/on_coral" android:background="@drawable/bg_action" android:textSize="13sp" android:clickable="true" android:focusable="true" />
    <TextView android:id="@+id/space_lectures_tab" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:gravity="center" android:text="Lectures" android:textColor="@color/text_muted" android:background="@drawable/bg_input" android:textSize="13sp" android:clickable="true" android:focusable="true" android:layout_marginStart="8dp" />
  </LinearLayout>
  <AutoCompleteTextView android:id="@+id/space_filter" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="14dp" android:background="@drawable/bg_input" android:hint="Fuzzy search all notes…" android:paddingHorizontal="14dp" android:textColor="@color/text_primary" android:textColorHint="@color/text_muted" />
  <TextView android:id="@+id/space_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/text_muted" />
  <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"><LinearLayout android:id="@+id/space_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" /></ScrollView>
</LinearLayout>