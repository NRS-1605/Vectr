<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/bg_home_hero" android:orientation="vertical" android:padding="22dp">
      <FrameLayout android:layout_width="wrap_content" android:layout_height="52dp">
        <TextView android:id="@+id/home_wordmark" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/space_mono" android:letterSpacing="-0.06" android:text="VeCTR" android:textColor="@color/text_primary" android:textSize="38sp" android:textStyle="bold" />
        <TextView android:id="@+id/home_blink_dot" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|start" android:layout_marginStart="23dp" android:layout_marginBottom="0dp" android:text="●" android:textColor="@color/accent_amber" android:textSize="18sp" />
      </FrameLayout>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:letterSpacing="0.15" android:text="LOCAL DEVICE CONSOLE" android:textColor="@color/text_muted" android:textSize="11sp" />
      <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="horizontal"><TextView android:id="@+id/home_uptime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textSize="11sp" /><TextView android:id="@+id/home_bounty" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="18dp" android:textColor="@color/accent_amber" android:textSize="11sp" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="18dp" android:text="BUILD 1.0.0" android:textColor="@color/text_muted" android:textSize="11sp" /></LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_home_status" android:orientation="vertical" android:padding="20dp">
      <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical"><ImageView android:id="@+id/connection_status_dot" android:layout_width="11dp" android:layout_height="11dp" /><TextView android:id="@+id/connection_status_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="9dp" android:textColor="@color/text_primary" android:textSize="15sp" /></LinearLayout>
      <TextView android:id="@+id/home_last_seen" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:textColor="@color/text_muted" android:textSize="12sp" />
      <TextView android:id="@+id/home_endpoint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_input" android:padding="12dp" android:textColor="@color/text_primary" android:textSize="12sp" />
      <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp"><Button android:id="@+id/home_reconnect" android:layout_width="wrap_content" android:layout_height="44dp" android:text="RECONNECT" /><Button android:id="@+id/home_edit" android:layout_width="wrap_content" android:layout_height="44dp" android:layout_marginStart="10dp" android:text="EDIT" /></LinearLayout>
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:gravity="center" android:letterSpacing="0.16" android:text="──────── MODULES ────────" android:textColor="@color/text_muted" android:textSize="12sp" />
    <GridLayout android:id="@+id/home_module_grid" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:columnCount="2" />
    <TextView android:id="@+id/pending_sync_indicator" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:textColor="@color/accent_amber" android:visibility="gone" />
  </LinearLayout>
</ScrollView>
