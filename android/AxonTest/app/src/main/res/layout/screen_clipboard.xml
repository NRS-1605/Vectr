<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
  <LinearLayout android:id="@+id/clipboard_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_home_hero" android:orientation="vertical" android:padding="20dp">
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:letterSpacing="0.13" android:text="CLIPBOARD HISTORY" android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold"/>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Copied text from all devices." android:textColor="@color/text_muted" android:textSize="12sp"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/clipboard_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical"/>
  </LinearLayout>
</ScrollView>
