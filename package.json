{
  "name": "axon-core",
  "version": "1.0.0",
  "description": "VeCTR local desktop core",
  "main": "server/app.js",
  "bin": "server/app.js",
  "scripts": {
    "start": "node server/app.js",
    "dev": "nodemon server/app.js",
    "build:dist": "mkdir -p dist && pkg . --targets node26-linux-x64 --output dist/vectr-core-linux && pkg . --targets node26-win-x64 --output dist/vectr-core-win.exe"
  },
  "dependencies": {
    "bonjour": "^3.5.1",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "multer": "^2.2.0",
    "rss-parser": "^3.13.0",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.21.0",
    "nodemon": "^3.1.4"
  },
  "pkg": {
    "assets": [
      "public/**/*",
      "SchedWall/views/**/*"
    ]
  }
}
